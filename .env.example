# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# X API v2 Bearer token (recent search)
X_BEARER_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
X_MAX_RESULTS=25
WEATHER_SEARCH_QUERY=(Singapore OR "Singapore weather" OR #Singapore) (weather OR rain OR hot OR humid OR haze OR storm OR forecast) lang:en -is:retweet
SENTIMENT_PROMPT_VERSION=weather-sentiment-v1
